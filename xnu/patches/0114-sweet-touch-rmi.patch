+static int
+rmi_write_reg(uint8_t reg, uint8_t val)
+{
+	uint8_t t[2] = {reg, val};
+	return bb_write(ts.syna_addr, t, 2);
+}
+
+static int
+rmi_read_reg(uint8_t reg, uint8_t *buf, unsigned n)
+{
+	return bb_read(ts.syna_addr, reg, buf, n);
+}
+
+/* OnePlus 7T S3706 speaks RMI4, not TouchComm. PDT entries are 6 bytes. */
+static int
+rmi_setup(void)
+{
+	uint8_t ent[6];
+	uint8_t ctrl = 0;
+	int err;
+	bool found = false;
+
+	err = rmi_write_reg(0xff, 0x00);
+	if (err) {
+		printf("SWEET TOUCH: rmi page %d\n", err);
+		return err;
+	}
+	for (unsigned addr = 0xe9; addr >= 0xc9; addr -= 6) {
+		err = rmi_read_reg((uint8_t)addr, ent, 6);
+		if (err) {
+			printf("SWEET TOUCH: rmi pdt %02x err=%d\n", addr, err);
+			break;
+		}
+		syna_log_hex("rmi", ent, 6);
+		printf("SWEET TOUCH: rmi fn %02x at %02x data=%02x ctrl=%02x\n",
+		    ent[5], addr, ent[3], ent[2]);
+		if (ent[5] == 0x00) {
+			break;
+		}
+		if (ent[5] == 0x12) {
+			ts.rmi_data = ent[3];
+			ts.rmi_ctrl = ent[2];
+			found = true;
+		} else if (ent[5] == 0x01) {
+			ts.rmi_f01_ctrl = ent[2];
+		}
+	}
+	if (!found) {
+		uint8_t b4[4];
+		if (rmi_read_reg(0xdd, b4, 4) == 0 && b4[3] != 0 && b4[3] != 0xff) {
+			ts.rmi_data = b4[3];
+			ts.rmi_ctrl = b4[2];
+			found = true;
+			printf("SWEET TOUCH: rmi fixed data=%02x ctrl=%02x\n", b4[3], b4[2]);
+		}
+		if (rmi_read_reg(0xe3, b4, 4) == 0) {
+			ts.rmi_f01_ctrl = b4[2];
+			printf("SWEET TOUCH: rmi f01 ctrl=%02x data=%02x\n", b4[2], b4[3]);
+		}
+	}
+	if (!found || ts.rmi_data == 0) {
+		return ENXIO;
+	}
+	if (ts.rmi_ctrl) {
+		uint8_t mx[4];
+		if (rmi_read_reg(ts.rmi_ctrl, mx, 4) == 0) {
+			ts.syna_max_x = (unsigned)mx[0] | ((unsigned)mx[1] << 8);
+			ts.syna_max_y = (unsigned)mx[2] | ((unsigned)mx[3] << 8);
+			if (ts.syna_max_x < 100 || ts.syna_max_x > 4096) {
+				ts.syna_max_x = 0;
+			}
+			if (ts.syna_max_y < 100 || ts.syna_max_y > 4096) {
+				ts.syna_max_y = 0;
+			}
+			printf("SWEET TOUCH: rmi max %u,%u\n", ts.syna_max_x, ts.syna_max_y);
+		}
+	}
+	if (ts.rmi_f01_ctrl) {
+		err = rmi_read_reg(ts.rmi_f01_ctrl, &ctrl, 1);
+		printf("SWEET TOUCH: rmi devctrl %02x err=%d\n", ctrl, err);
+		if (err == 0) {
+			rmi_write_reg(ts.rmi_f01_ctrl, (uint8_t)((ctrl & 0xf8) | 0x80));
+		}
+		rmi_write_reg((uint8_t)(ts.rmi_f01_ctrl + 1), 0x7f);
+	}
+	ts.rmi = true;
+	printf("SWEET TOUCH: rmi ready data=%02x\n", ts.rmi_data);
+	return 0;
+}
+
+static int
+rmi_poll(void)
+{
+	uint8_t buf[16];
+	int err;
+	unsigned seen = 0;
+	unsigned nslot = sizeof(buf) / 8u;
+
+	err = rmi_read_reg(ts.rmi_data, buf, sizeof(buf));
+	if (err) {
+		return -1;
+	}
+	if (ts.syna_reports < 2) {
+		syna_log_hex("f12", buf, sizeof(buf));
+	}
+	for (unsigned i = 0; i < nslot && i < TS_MAX_FINGERS; ++i) {
+		unsigned o = i * 8u;
+		unsigned st = (unsigned)buf[o] & 0x07u;
+		unsigned x = ((unsigned)(buf[o + 2] & 0x0f) << 8) | buf[o + 1];
+		unsigned y = ((unsigned)(buf[o + 4] & 0x0f) << 8) | buf[o + 3];
+		if (st >= 1 && st <= 3) {
+			seen |= 1u << i;
+			syna_note_finger(i, true, x, y, buf[o]);
+		}
+	}
+	for (unsigned i = 0; i < TS_MAX_FINGERS; ++i) {
+		if ((seen & (1u << i)) == 0) {
+			syna_note_finger(i, false, 0, 0, 0);
+		}
+	}
+	return 0;
+}
