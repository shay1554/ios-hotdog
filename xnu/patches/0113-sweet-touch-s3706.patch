+/* TouchComm is not a register protocol: a read is just the address byte. */
+static int
+bb_read_raw(uint8_t addr, uint8_t *buf, unsigned n)
+{
+	int err;
+
+	bb_start();
+	bb_tx_byte((uint8_t)((addr << 1) | 1u));
+	err = bb_ack();
+	for (unsigned i = 0; i < n && err == 0; ++i) {
+		buf[i] = bb_rx_byte(i + 1u < n);
+	}
+	bb_stop();
+	return err;
+}
