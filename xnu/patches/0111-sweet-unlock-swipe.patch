@@ -15,8 +15,11 @@
 #include <pexpert/arm64/sweet_dev.h>
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
 extern void sweet_hid_key(int key, int down);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
 void sweet_keys_init(void);
+static void sweet_swipe_thread(void *arg, wait_result_t result);
 
 #define KEYS_CORE_PA     SWEET_DEV_SPMI_CORE_PA
 #define KEYS_OBS_PA      SWEET_DEV_SPMI_OBS_PA
@@ -278,5 +281,47 @@
 	} else {
 		printf("SWEET KEYS: kernel_thread_start failed %d\n", kr);
 	}
+	int unlock = 0;
+	if (PE_parse_boot_argn("sweetunlock", &unlock, sizeof(unlock)) && unlock) {
+		kr = kernel_thread_start(sweet_swipe_thread, NULL, &thread);
+		if (kr == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		} else {
+			printf("SWEET KEYS: swipe thread failed %d\n", kr);
+		}
+	}
+}
+
+/*
+ * Synthetic unlock swipe (boot-arg sweetunlock=1) for boards whose touch IC
+ * has no driver yet: push a HID finger from the home bar upwards twice.
+ */
+static void
+swipe_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&keys_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+sweet_swipe_thread(void *arg, wait_result_t result)
+{
+	const int x = 562, y0 = 2300, y1 = 900, steps = 28;
+	(void)arg;
+	(void)result;
+	for (int attempt = 0; attempt < 12; ++attempt) {
+		swipe_wait(attempt ? 25000 : 45000);
+		printf("SWEET KEYS: synthetic unlock swipe %d\n", attempt + 1);
+		sweet_hid_touch(0, 1, x, y0);
+		for (int i = 1; i <= steps; ++i) {
+			sweet_hid_touch(0, 1, x, y0 + (y1 - y0) * i / steps);
+			swipe_wait(8);
+		}
+		sweet_hid_touch(0, 0, x, y1);
+	}
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
 }
 #endif /* ARM64_BOARD_CONFIG_SWEET */
